{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.Steffen-W.KiCad_Pinout",
  "name": "KiCadPinout",
  "description": "KiCadPinout: generates formatted pinout documentation from PCB components. ",
  "runtime": {
    "type": "python",
    "version": "3"
  },
  "actions": [
    {
      "identifier": "KiCadPinout-action",
      "name": "Pinout Generator",
      "description": "KiCadPinout",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "plugin_action.py",
      "icons-light": [
        "icon.png"
      ],
      "icons-dark": [
        "icon.png"
      ]
    }
  ]
}