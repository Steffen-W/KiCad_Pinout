[MASTER]
jobs=4
py-version=3.10
ignore=gui.py,test,venv,build,dist

[MESSAGES CONTROL]
disable=
    # Formatting (handled by ruff)
    C0301, C0303, C0304, W0311,

    # Docstrings
    C0114, C0115, C0116,

    # Naming (KiCad uses CamelCase/non-snake conventions)
    C0103,

    # External libs without stubs (pcbnew, kipy, wx)
    E0401, E0402, E0611, E1101,

    # KiCad plugin patterns
    C0415,  # import-outside-toplevel (has_pcbnew/has_IPC/connect_kicad pattern)
    W0611,  # unused-import (availability-test imports)
    W0201,  # attribute-defined-outside-init (defaults() pattern)
    C2801,  # unnecessary-dunder-call (dynamic class creation)
    W0404,  # reimported (conditional imports for pcbnew/IPC)
    W0613,  # unused-argument (wx event handler signatures)
    W0718,  # broad-exception-caught (intentional at plugin boundaries)

[BASIC]
good-names=i,j,k,fp,x,y,id,e,f

[FORMAT]
max-line-length=100
